// Canonical runtime model. Flyway migrations are the upgrade mechanism.

Table users {
  user_id bigint [pk, increment]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone_number varchar(32) [not null, unique]
  password varchar(255) [not null, note: 'BCrypt password hash']
  role varchar(16) [not null, default: 'USER', note: 'USER or ADMIN']
  is_enabled boolean [not null, default: false]
  version bigint [not null, default: 0, note: 'Optimistic-lock version']
  registration_pending boolean [not null, default: false]
  token_version bigint [not null, default: 0]
  pending_email varchar(255)
  phone_verified_at timestamp
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (pending_email) [unique, name: 'uk_users_pending_email']
  }
}

Table posts {
  post_id bigint [pk, increment]
  title varchar(100) [not null]
  price numeric(10,2) [not null]
  description varchar(1000) [not null]
  category varchar(32) [not null, note: 'ELECTRONICS, BOOKS, CLOTHING, FURNITURE, SPORTS, FOOD, SERVICES, OTHER']
  is_sold boolean [not null, default: false]
  version bigint [not null, default: 0]
  idempotency_key varchar(128)
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp
  status varchar(16) [not null, default: 'ACTIVE', note: 'ACTIVE, ARCHIVED, or SOLD']
  reminder_sent_at timestamp
  sold_at timestamp
  seller_user_id bigint [not null]
  buyer_user_id bigint

  Indexes {
    (seller_user_id, idempotency_key) [unique, name: 'uk_posts_seller_idempotency']
    (created_at, post_id) [name: 'idx_posts_public_listing']
    (category, created_at, post_id) [name: 'idx_posts_public_category']
    (expires_at, post_id) [name: 'idx_posts_expiration_window']
    seller_user_id
    buyer_user_id
  }
}

Table post_media {
  id bigint [pk, increment]
  post_id bigint [not null]
  media_url text [not null]
  image_hash varchar(255) [note: 'SHA-256 when supplied by the bot']
  cloudinary_public_id varchar(255) [note: 'Provider asset id for rollback/garbage collection']
  display_order integer [not null, default: 0]
  is_cover boolean [not null, default: false]

  Indexes {
    (post_id, display_order) [unique, name: 'uk_post_media_post_order']
    (post_id) [name: 'idx_post_media_post_order']
    image_hash [name: 'idx_post_media_image_hash']
    cloudinary_public_id [name: 'idx_post_media_cloudinary_public_id']
  }
}

Table favourites {
  id bigint [pk, increment]
  user_id bigint [not null]
  post_id bigint [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (user_id, post_id) [unique, name: 'uk_favourites_user_post']
    post_id [name: 'idx_favourites_post_id']
  }
}

Table whatsapp_login_sessions {
  id uuid [pk]
  session_id uuid [not null, unique]
  login_token uuid [not null, unique]
  claim_token uuid [unique]
  status varchar(32) [not null, note: 'PENDING, COMPLETED, PHONE_NOT_LINKED, EXPIRED, CLAIMED']
  user_id bigint
  phone_number varchar(32)
  creator_ip varchar(255) [not null]
  created_at timestamp [not null, default: `now()`]
  expires_at timestamp [not null]
  completed_at timestamp
  claimed_at timestamp

  Indexes {
    (status, expires_at) [name: 'idx_whatsapp_sessions_status_expiry']
    user_id [name: 'idx_whatsapp_sessions_user_id']
  }
}

Table password_reset_tokens {
  id bigint [pk, increment]
  token_hash varchar(255) [not null, unique]
  user_id bigint [not null]
  expires_at timestamp [not null]
  used boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (user_id, expires_at) [name: 'idx_password_reset_user_expiry']
  }
}

Table email_verification_tokens {
  id bigint [pk, increment]
  code_hash varchar(255) [not null]
  user_id bigint [not null]
  expires_at timestamp [not null]
  used boolean [not null, default: false]
  target_email varchar(255)
  attempts integer [not null, default: 0]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (user_id, used, created_at) [name: 'idx_email_verification_user_state']
  }
}

Table sales {
  id bigint [pk, increment]
  post_id bigint [not null, unique]
  seller_user_id bigint [not null]
  buyer_user_id bigint [not null]
  sold_at timestamp [not null]
  buyer_confirmed_at timestamp [note: 'Buyer confirmation gates review eligibility']
  title_snapshot varchar(100) [not null]
  price_snapshot numeric(10,2) [not null]
  created_at timestamp [not null, default: `now()`]

  Indexes {
    seller_user_id [name: 'idx_sales_seller_user_id']
    buyer_user_id [name: 'idx_sales_buyer_user_id']
    (buyer_user_id, buyer_confirmed_at, sold_at) [name: 'idx_sales_buyer_confirmation']
  }
}

Table reviews {
  review_id bigint [pk, increment]
  sale_id bigint [not null]
  reviewer_user_id bigint [not null]
  reviewee_user_id bigint [not null]
  direction varchar(32) [not null, note: 'BUYER_TO_SELLER or SELLER_TO_BUYER']
  rating integer [not null, note: '1 to 5']
  comment varchar(500)
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (sale_id, direction) [unique, name: 'uk_review_sale_direction']
    (reviewee_user_id, direction, created_at, review_id) [name: 'idx_reviews_reviewee_direction_created_at']
    reviewer_user_id [name: 'idx_reviews_reviewer_user_id']
  }
}

Table api_rate_limit_windows {
  rate_key varchar(320) [pk]
  window_start timestamp [not null]
  request_count integer [not null, default: 0]
}

Table notification_outbox {
  id bigint [pk, increment]
  dedupe_key varchar(320) [not null, unique]
  type varchar(40) [not null]
  recipient varchar(255) [not null]
  payload text [not null]
  aggregate_id bigint
  attempts integer [not null, default: 0]
  next_attempt_at timestamp [not null, default: `now()`]
  claimed_at timestamp
  sent_at timestamp
  last_error varchar(1000)
  created_at timestamp [not null, default: `now()`]

  Indexes {
    (sent_at, next_attempt_at) [name: 'idx_notification_outbox_due']
    created_at [name: 'idx_notification_outbox_created_at']
  }
}

Table migration_sale_quarantine {
  post_id bigint [pk]
  seller_user_id bigint
  buyer_user_id bigint
  title varchar(100)
  price decimal(10,2)
  sold_at timestamp
  reason text [not null]
  captured_at timestamp [not null, default: `now()`]
}

Table migration_review_quarantine {
  review_id bigint [pk]
  post_id bigint
  reviewer_user_id bigint
  reviewee_user_id bigint
  direction varchar(32)
  rating integer
  comment varchar(500)
  created_at timestamp
  reason text [not null]
  captured_at timestamp [not null, default: `now()`]
}

Ref: posts.seller_user_id > users.user_id
Ref: posts.buyer_user_id > users.user_id
Ref: post_media.post_id > posts.post_id
Ref: favourites.user_id > users.user_id
Ref: favourites.post_id > posts.post_id
Ref: whatsapp_login_sessions.user_id > users.user_id
Ref: password_reset_tokens.user_id > users.user_id
Ref: email_verification_tokens.user_id > users.user_id
Ref: sales.post_id > posts.post_id
Ref: sales.seller_user_id > users.user_id
Ref: sales.buyer_user_id > users.user_id
Ref: reviews.sale_id > sales.id
Ref: reviews.reviewer_user_id > users.user_id
Ref: reviews.reviewee_user_id > users.user_id
