SPRING_BASE_URL=http://localhost:8080
BOT_API_KEY=replace-with-your-bot-api-key
APP_BASE_URL=http://localhost:8080
BOT_WEBHOOK_PORT=3001
TARGET_GROUP_JID=120363406751456779@g.us

# LLM provider routing
# Options today: gemini, openai-compatible
LLM_PRIMARY_PROVIDER=gemini
# Comma-separated fallback chain (optional), e.g. openai-compatible
LLM_FALLBACK_PROVIDERS=

# Gemini provider
GEMINI_API_KEY=replace-with-your-gemini-key
# Optional comma-separated fallback list
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-1.5-flash-8b,gemini-1.5-flash

# OpenAI-compatible provider (LiteLLM on VPS)
LITELLM_BASE_URL=https://ai.zachar3.duckdns.org/v1
LITELLM_API_KEY=replace-with-your-litellm-key
LITELLM_MODEL=ollama/gemma4:e4b

# Optional observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
