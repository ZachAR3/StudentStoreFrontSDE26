SPRING_BASE_URL=http://localhost:8080
BOT_API_KEY=replace-with-your-bot-api-key
# Required: the bot refuses to start without APP_BASE_URL and TARGET_GROUP_JID.
APP_BASE_URL=http://localhost:8080
BOT_WEBHOOK_PORT=3001
# Loopback by default; only widen if the backend runs on another host.
BOT_WEBHOOK_HOST=127.0.0.1
TARGET_GROUP_JID=replace-with-your-group-jid@g.us

# LLM provider routing
# Options today: gemini, openai-compatible
LLM_PRIMARY_PROVIDER=openai-compatible
# Comma-separated fallback chain (optional), e.g. openai-compatible
LLM_FALLBACK_PROVIDERS=

# Gemini provider
GEMINI_API_KEY=replace-with-your-gemini-key
# Optional comma-separated fallback list
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# OpenAI provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-5.4-nano
# Increase if image price sheets contain many separate items.
LISTING_PARSE_MAX_TOKENS=2000

# Per-request LLM timeout (ms)
LLM_TIMEOUT_MS=45000

# Optional observability
# Traces identify users by an HMAC of their number; set a private salt.
TRACE_ID_SALT=replace-with-a-random-string
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# Runtime dependency: ImageMagick's `magick` command downsizes photos before
# they go to the LLM. Without it the bot logs a warning at startup and sends
# full-size images (slower, more expensive). Debian/Ubuntu: apt install imagemagick
