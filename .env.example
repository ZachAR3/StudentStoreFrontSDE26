# ===============================
# SERVER / DEPLOYMENT
# ===============================
# Prefer 127.0.0.1 with aaPanel/Nginx on the same server terminating TLS.
# Use 0.0.0.0 only if port 8080 must be reachable directly (e.g. router
# forwarding), and then only over HTTPS.
SPRING_BIND_ADDRESS=127.0.0.1
SPRING_PORT=8080
APP_BASE_URL=https://your-subdomain.duckdns.org
# "prod" enforces strong secrets and turns off SQL logging. Use "local" only
# on a developer machine.
SPRING_PROFILES_ACTIVE=prod
# JVM time zone. Stored timestamps depend on it, so never change it on an
# existing database (see AUDIT.md DB-02).
APP_TIMEZONE=Europe/Berlin

# ===============================
# DATABASE
# ===============================
DB_USERNAME=student_app
DB_PASSWORD=replace-with-a-long-local-db-password
POSTGRES_ADMIN_USER=student_postgres_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-admin-password
FLYWAY_USERNAME=student_migrations
FLYWAY_PASSWORD=replace-with-a-long-migration-password

# ===============================
# JWT
# ===============================
JWT_SECRET=

# ===============================
# EMAIL
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional local-only demo bootstrap. No demo user is created unless all three
# values are supplied; never use a shared/default password here.
DEMO_USER_EMAIL=
DEMO_USER_PHONE=
DEMO_USER_PASSWORD=

# ===============================
# CLOUDINARY (required for image uploads)
# ===============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
