# ===============================
# SERVER / DEPLOYMENT
# ===============================
# Use 0.0.0.0 when exposing port 8080 through DuckDNS/router forwarding.
# Use 127.0.0.1 when only aaPanel/Nginx on the same server should reach Spring.
SPRING_BIND_ADDRESS=0.0.0.0
SPRING_PORT=8080
APP_BASE_URL=https://your-subdomain.duckdns.org
SPRING_PROFILES_ACTIVE=local

# ===============================
# DATABASE
# ===============================
DB_USERNAME=student
DB_PASSWORD=

# ===============================
# JWT
# ===============================
JWT_SECRET=

# ===============================
# EMAIL
# ===============================
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
